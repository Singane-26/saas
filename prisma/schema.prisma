// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// GESTION DU COMPTE
// ============================================================

model Organization {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  phone       String   @unique @db.VarChar(20)
  email       String?  @db.VarChar(255)
  address     String?  @db.Text
  logoUrl     String?  @db.VarChar(500) @map("logo_url")
  ninea       String?  @db.VarChar(20)
  currency    String   @default("XOF") @db.Char(3)
  trialEndsAt DateTime @map("trial_ends_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users              User[]
  auditLogs          AuditLog[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  sales              Sale[]
  expenses           Expense[]
  subscriptions      Subscription[]
  publicCatalog      PublicCatalog?
  onlineOrders       OnlineOrder[]
  customerMessages   CustomerMessage[]
  whatsappTemplates  WhatsappTemplate[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  MANAGER
  SELLER

  @@map("user_role")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  phone          String   @unique @db.VarChar(20)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  fullName       String   @map("full_name") @db.VarChar(150)
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]
  stockMovements StockMovement[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  orderStatusChanges OrderStatusHistory[]

  @@index([organizationId])
  @@map("users")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id")
  details        Json?    @db.JsonB
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================
// CATALOGUE & STOCK
// ============================================================

model Category {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String   @db.VarChar(100)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Product {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  categoryId      String?  @map("category_id")
  name            String   @db.VarChar(200)
  sku             String?  @db.VarChar(50)
  barcode         String?  @db.VarChar(50)
  buyPrice        Int      @default(0) @map("buy_price")    // Prix d'achat en FCFA (entier)
  sellPrice       Int      @map("sell_price")                // Prix de vente en FCFA (entier)
  quantityInStock Int      @default(0) @map("quantity_in_stock")
  alertThreshold  Int      @default(5) @map("alert_threshold")
  unit            String   @default("pièce") @db.VarChar(30)
  isActive        Boolean  @default(true) @map("is_active")
  isPublished     Boolean  @default(false) @map("is_published")  // Visible dans le catalogue public
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  orderItems     OrderItem[]

  @@index([organizationId, name])
  @@index([barcode])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN

  @@map("stock_movement_type")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  productId      String            @map("product_id")
  userId         String?           @map("user_id")
  type           StockMovementType
  quantity       Int               // Positif = entrée, négatif = sortie
  reference      String?           @db.VarChar(100)
  note           String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

// ============================================================
// VENTES & FACTURATION
// ============================================================

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fullName       String   @map("full_name") @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  address        String?  @db.Text
  notes          String?  @db.Text
  balanceDue     Int      @default(0) @map("balance_due") // Solde dû en FCFA
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales            Sale[]
  onlineOrders     OnlineOrder[]
  customerMessages CustomerMessage[]

  @@index([organizationId, fullName])
  @@map("customers")
}

enum SaleStatus {
  COMPLETED
  PARTIAL
  CREDIT
  CANCELLED

  @@map("sale_status")
}

model Sale {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  userId         String     @map("user_id")
  customerId     String?    @map("customer_id")
  saleNumber     String     @unique @map("sale_number") @db.VarChar(30)
  totalAmount    Int        @map("total_amount")
  discountAmount Int        @default(0) @map("discount_amount")
  netAmount      Int        @map("net_amount")
  amountPaid     Int        @default(0) @map("amount_paid")
  amountDue      Int        @default(0) @map("amount_due")
  status         SaleStatus
  notes          String?    @db.Text
  synced         Boolean    @default(true)  // FALSE = créée hors ligne
  createdAt      DateTime   @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  invoice        Invoice?

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id          String @id @default(uuid())
  saleId      String @map("sale_id")
  productId   String @map("product_id")
  productName String @map("product_name") @db.VarChar(200)  // Snapshot du nom au moment de la vente
  quantity    Int
  unitPrice   Int    @map("unit_price")                      // Prix unitaire au moment de la vente
  totalPrice  Int    @map("total_price")                     // quantity × unitPrice

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  CREDIT
  OTHER

  @@map("payment_method")
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String        @map("sale_id")
  amount    Int
  method    PaymentMethod
  reference String?       @db.VarChar(100) // Référence de transaction mobile
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  // Relations
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum InvoiceType {
  RECEIPT
  INVOICE

  @@map("invoice_type")
}

model Invoice {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  saleId         String      @unique @map("sale_id")
  invoiceNumber  String      @unique @map("invoice_number") @db.VarChar(30)
  type           InvoiceType
  pdfUrl         String?     @map("pdf_url") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  category       String   @db.VarChar(100)  // Loyer, transport, électricité...
  amount         Int
  description    String?  @db.Text
  receiptUrl     String?  @map("receipt_url") @db.VarChar(500)
  expenseDate    DateTime @map("expense_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, expenseDate(sort: Desc)])
  @@map("expenses")
}

// ============================================================
// CATALOGUE PUBLIC & COMMANDES EN LIGNE (Produit B)
// ============================================================

model PublicCatalog {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  slug           String   @unique @db.VarChar(100)  // URL: /c/ma-boutique
  title          String   @db.VarChar(150)
  description    String?  @db.Text
  bannerUrl      String?  @map("banner_url") @db.VarChar(500)
  whatsappNumber String   @map("whatsapp_number") @db.VarChar(20)
  deliveryZones  String?  @map("delivery_zones") @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("public_catalogs")
}

enum OrderStatus {
  NEW
  CONFIRMED
  PAID
  SHIPPING
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum OrderSource {
  CATALOG
  WHATSAPP
  MANUAL

  @@map("order_source")
}

model OnlineOrder {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  customerId      String      @map("customer_id")
  orderNumber     String      @unique @map("order_number") @db.VarChar(30)
  status          OrderStatus @default(NEW)
  totalAmount     Int         @map("total_amount")
  deliveryAddress String?     @map("delivery_address") @db.Text
  deliveryFee     Int         @default(0) @map("delivery_fee")
  notes           String?     @db.Text
  source          OrderSource @default(CATALOG)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer             @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  customerMessages CustomerMessage[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("online_orders")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  productId   String @map("product_id")
  productName String @map("product_name") @db.VarChar(200)
  quantity    Int
  unitPrice   Int    @map("unit_price")
  totalPrice  Int    @map("total_price")

  // Relations
  order   OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  changedBy String?     @map("changed_by")
  note      String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  order OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@map("order_status_history")
}

enum MessageDirection {
  OUTBOUND
  INBOUND

  @@map("message_direction")
}

enum MessageChannel {
  WHATSAPP
  SMS

  @@map("message_channel")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("message_status")
}

model CustomerMessage {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  customerId        String           @map("customer_id")
  orderId           String?          @map("order_id")
  direction         MessageDirection
  channel           MessageChannel
  templateName      String?          @map("template_name") @db.VarChar(100)
  content           String           @db.Text
  status            MessageStatus    @default(PENDING)
  whatsappMessageId String?          @map("whatsapp_message_id") @db.VarChar(100)
  sentAt            DateTime?        @map("sent_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  order        OnlineOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("customer_messages")
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION

  @@map("template_category")
}

enum TemplateApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("template_approval_status")
}

model WhatsappTemplate {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  name           String                 @db.VarChar(100)
  category       TemplateCategory
  content        String                 @db.Text
  language       String                 @default("fr") @db.Char(5)
  approvalStatus TemplateApprovalStatus @default(PENDING) @map("approval_status")
  createdAt      DateTime               @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_templates")
}

// ============================================================
// ABONNEMENTS & PAIEMENTS PLATEFORME
// ============================================================

enum SubscriptionPlan {
  BASIC
  PRO

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("subscription_status")
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  amount             Int                // Montant mensuel en FCFA
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@index([organizationId])
  @@map("subscriptions")
}

enum SubscriptionPaymentStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("subscription_payment_status")
}

model SubscriptionPayment {
  id                String                    @id @default(uuid())
  subscriptionId    String                    @map("subscription_id")
  amount            Int
  method            PaymentMethod
  providerReference String?                   @map("provider_reference") @db.VarChar(100)
  status            SubscriptionPaymentStatus @default(PENDING)
  paidAt            DateTime?                 @map("paid_at")
  createdAt         DateTime                  @default(now()) @map("created_at")

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

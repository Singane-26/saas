# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/jangiboutik?schema=public"

# Authentification JWT
JWT_SECRET="votre-secret-jwt-a-changer-en-production"
JWT_EXPIRES_IN="7d"

# PayDunya (agrégateur de paiement)
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MODE="test"

# WhatsApp Business API (via 360dialog ou direct Meta Cloud API)
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JangiBoutik"

# SMS (pour vérification de compte — optionnel, WhatsApp en priorité)
SMS_API_KEY=""
SMS_SENDER_NAME="JangiBoutik"
